# Template/runtime
CHARGESHEET_TEMPLATE_ID=nwa_internal_medicine_superbill_locked_v1
CHARGESHEET_TEMPLATE_VERSION=1
CHARGESHEET_RENDER_DPI=200
CHARGESHEET_PIPELINE_VERSION=locked-coordinate-extraction-v2
CHARGESHEET_HEADER_MODEL=claude-opus-4-6
CHARGESHEET_HEADER_EXTRACTOR_VERSION=header_notes_v1
CHARGESHEET_ENABLE_HEADER_NOTES=true

# Option A: direct Anthropic credentials
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# Option B: Azure Key Vault + Foundry; authenticate locally with `az login`
# AZURE_KEY_VAULT_URL=https://<your-vault>.vault.azure.net/
# ANTHROPIC_KEY_SECRET=834-claude-key
# ANTHROPIC_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic/
